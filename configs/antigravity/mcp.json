{
  "mcpServers": {
    "composio": {
      "serverUrl": "https://connect.composio.dev/mcp",
      "headers": {
        "x-consumer-api-key": "{env:COMPOSIO_API_KEY}"
      }
    },
    "1password": {
      "command": "1password-mcp",
      "args": []
    },
    "gitkraken": {
      "command": "gk",
      "args": ["mcp"]
    },
    "playwright": {
      "command": "bunx",
      "args": ["--bun", "@playwright/mcp", "--browser", "chrome", "--user-data-dir", "{env:HOME}/.playwright/chrome"]
    }
  }
}
