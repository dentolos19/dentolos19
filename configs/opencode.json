{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "permission": "allow",
  "default_agent": "build",
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-terra",
      "variant": "high",
      "description": "Writes, edits, and tests code to implement features and fix bugs."
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "description": "Researches the codebase and plans changes without modifying files."
    },
    "general": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    },
    "compaction": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    }
  },
  "command": {
    "review": {
      "agent": "build",
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "template": "Perform a thorough code review of the current changes (unless stated otherwise). Inspect both staged and unstaged changes. Focus on correctness, bugs, vulnerabilities, performance, maintainability, and error handling. Additional review instructions: $ARGUMENTS",
      "description": "Run a thorough code review of the current staged and unstaged changes."
    },
    "export": {
      "agent": "build",
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "high",
      "template": "Take in the entire context of this session or conversation, compact it, and export it into a markdown file in the current directory. Name the file appropriately. Additional export instructions: $ARGUMENTS",
      "description": "Export the session context into a markdown file."
    }
  },
  "provider": {
    "opencode": {
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY}"
      }
    },
    "opencode-go": {
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY}"
      }
    },
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    },
    "platformai": {
      "name": "Platform AI",
      "models": {
        "bedrock.claude-opus-4-8": {
          "name": "Claude Opus 4.8"
        },
        "bedrock.claude-sonnet-5": {
          "name": "Claude Sonnet 5"
        }
      },
      "options": {
        "baseURL": "https://api.ai.tech.gov.sg/platform/models/v1",
        "apiKey": "{env:PLATFORMAI_API_KEY}"
      }
    }
  },
  "mcp": {
    "monolith": {
      "type": "remote",
      "url": "https://monolith.dennise.me/mcp",
      "headers": {
        "CF-Access-Client-Id": "{env:CLOUDFLARE_CLIENT_ID}",
        "CF-Access-Client-Secret": "{env:CLOUDFLARE_CLIENT_SECRET}"
      }
    },
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "headers": {
        "X-Consumer-Api-Key": "{env:COMPOSIO_API_KEY}"
      }
    },
    "gitkraken": {
      "type": "local",
      "command": ["gk", "mcp"]
    },
    "1password": {
      "type": "local",
      "command": ["1password-mcp"]
    },
    "playwright": {
      "type": "local",
      "command": ["bunx", "--bun", "@playwright/mcp"]
    }
  }
}
