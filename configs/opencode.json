{
  "$schema": "https://opencode.ai/config.json",
  "update": "notify",

  "providers": {
    "platform-ai": {
      "name": "Platform AI",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.ai.tech.gov.sg/platform/models/v1"
      },
      "headers": {
        "x-api-key": "{env:PLATFORMAI_API_KEY}"
      },
      "models": {
        "bedrock.claude-opus-5-5": {
          "name": "Claude Opus 5.5",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 64000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "bedrock.claude-sonnet-5-5": {
          "name": "Claude Sonnet 5.5",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 64000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "bedrock.claude-haiku-5-5": {
          "name": "Claude Haiku 5.5",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 64000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "agents": {
    "build": {
      "model": "openai/gpt-6.1-sol#high"
    },
    "plan": {
      "model": "openai/gpt-6.1-sol#high"
    },
    "compaction": {
      "model": "openai/gpt-6.1-terra#max"
    },
    "general": {
      "model": "openai/gpt-6.1-terra#max",
      "hidden": true
    },
    "explore": {
      "model": "openai/gpt-6.1-terra#max",
      "hidden": true
    }
  },
  "mcp": {
    "servers": {
      "composio": {
        "type": "remote",
        "url": "https://connect.composio.dev/mcp"
      },
      "gitkraken": {
        "type": "local",
        "command": ["gk", "mcp"]
      },
      "1password": {
        "type": "local",
        "command": ["1password-mcp"]
      },
      "playwright": {
        "type": "local",
        "command": ["bunx", "--bun", "@playwright/mcp"]
      }
    }
  },
  "plugins": ["@dietrichgebert/ponytail"]
}
