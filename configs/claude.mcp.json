{
  "mcpServers": {
    "1password": {
      "type": "stdio",
      "command": "1password-mcp",
      "args": []
    },
    "gitkraken": {
      "type": "stdio",
      "command": "gk",
      "args": ["mcp"]
    },
    "playwright": {
      "type": "stdio",
      "command": "bunx",
      "args": ["--bun", "@playwright/mcp", "--browser", "chrome", "--user-data-dir", "{env:HOME}/.playwright/chrome"]
    }
  }
}
