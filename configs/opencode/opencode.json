{
  "$schema": "https://opencode.ai/config.json",
  "update": "notify",
  "providers": {
    "platform-ai": {
      "name": "Platform AI",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.ai.tech.gov.sg/platform/models/v1"
      },
      "headers": {
        "x-api-key": "{env:PLATFORMAI_API_KEY}"
      },
      "models": {
        "bedrock.claude-opus-5-5": {
          "name": "Claude Opus 5.5",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 64000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "bedrock.claude-sonnet-5-5": {
          "name": "Claude Sonnet 5.5",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 64000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "bedrock.claude-haiku-5-5": {
          "name": "Claude Haiku 5.5",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 64000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "agents": {
    "build": {
      "model": "platform-ai/bedrock.claude-opus-5-5"
    },
    "plan": {
      "model": "platform-ai/bedrock.claude-opus-5-5"
    },
    "compaction": {
      "model": "platform-ai/bedrock.claude-sonnet-5-5"
    },
    "general": {
      "model": "platform-ai/bedrock.claude-sonnet-5-5",
      "hidden": true
    },
    "explore": {
      "model": "platform-ai/bedrock.claude-haiku-5-5",
      "hidden": true
    }
  },
  "mcp": {
    "servers": {
      "composio": {
        "type": "remote",
        "url": "https://connect.composio.dev/mcp",
        "headers": {
          "x-consumer-api-key": "{env:COMPOSIO_API_KEY}"
        }
      },
      "denizen": {
        "type": "remote",
        "url": "https://dennise.me/mcp",
        "headers": {
          "x-api-key": "{env:DENIZEN_API_KEY}"
        }
      },
      "1password": {
        "type": "local",
        "command": ["1password-mcp"]
      },
      "gitkraken": {
        "type": "local",
        "command": ["gk", "mcp"]
      },
      "cua": {
        "type": "local",
        "command": ["cua-driver", "mcp", "--grant", "existing-profile"]
      },
      "playwright": {
        "type": "local",
        "command": [
          "bunx",
          "--bun",
          "@playwright/mcp",
          "--browser",
          "chrome",
          "--user-data-dir",
          "{env:HOME}/.playwright/chrome"
        ]
      },
      "blender": {
        "type": "local",
        "command": ["uvx", "mcp-for-blender"]
      }
    }
  }
}
