{
  "preferences": {
    "ccdScheduledTasksEnabled": true,
    "ccNextActions": false,
    "ccPromptSuggestions": false,
    "ccRemoteControlDefaultEnabled": false,
    "claudeIosSimulatorAccessEnabled": false,
    "coworkBrowserToolsEnabled": true,
    "coworkPreferredBrowser": "built_in",
    "coworkScheduledTasksEnabled": true,
    "coworkWebSearchEnabled": true,
    "remoteControlStayReachable": true,
    "sidebarMode": "epitaxy"
  },
  "mcpServers": {
    "1password": {
      "command": "1password-mcp",
      "args": []
    },
    "gitkraken": {
      "command": "gk",
      "args": ["mcp"]
    },
    "playwright": {
      "command": "bunx",
      "args": ["--bun", "@playwright/mcp", "--browser", "chrome", "--user-data-dir", "{env:HOME}/.playwright/chrome"]
    }
  }
}
