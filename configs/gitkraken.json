{
  "appDateFormat": "YYYY-MM-DD",
  "appDateTimeFormat": "YYYY-MM-DD h:mm A",
  "keepGitConfigInSyncWithProfile": true,
  "useCustomProvider": true,
  "profiles": {
    "Personal": {
      "ai": {
        "sendCodeApproved": true
      },
      "cli": {
        "fontFamily": "\"JetBrainsMono Nerd Font\""
      },
      "editor": {
        "fontFamily": "\"JetBrainsMono Nerd Font\""
      },
      "externalTools": {
        "editor": {
          "externalEditorName": "VS Code"
        }
      },
      "gpg": {
        "commitGpgSign": true,
        "gpgFormat": "ssh",
        "tagForceSignAnnotated": true
      },
      "ssh": {
        "useGitCredentialManager": true,
        "useLocalAgent": true
      }
    },
    "Work": {
      "ai": {
        "sendCodeApproved": true
      },
      "cli": {
        "fontFamily": "\"JetBrainsMono Nerd Font\""
      },
      "editor": {
        "fontFamily": "\"JetBrainsMono Nerd Font\""
      },
      "externalTools": {
        "editor": {
          "externalEditorName": "VS Code"
        }
      },
      "gpg": {
        "commitGpgSign": true,
        "gpgFormat": "ssh",
        "tagForceSignAnnotated": true
      },
      "ssh": {
        "useGitCredentialManager": true,
        "useLocalAgent": true
      }
    }
  },
  "ai": {
    "customProvider": "ConfigurableOpenAI",
    "providers": {
      "ConfigurableOpenAI": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "commitMessage": {
          "model": "openai/gpt-6.1-terra"
        },
        "conflictResolution": {
          "model": "openai/gpt-6.1-terra"
        },
        "explainCommits": {
          "model": "openai/gpt-6.1-terra"
        },
        "pullRequest": {
          "model": "openai/gpt-6.1-terra"
        },
        "rebase": {
          "model": "openai/gpt-6.1-terra"
        },
        "stashMessage": {
          "model": "openai/gpt-6.1-terra"
        }
      }
    }
  }
}
